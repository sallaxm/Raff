# Copy to .env.local and fill in. Never commit real keys.

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by API routes for uploads, downloads and moderation.
# Do NOT prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site, used in sign-up and password-reset email links.
# Falls back to the browser's origin if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Feedback page sends messages (opens the user's email app).
NEXT_PUBLIC_CONTACT_EMAIL=
