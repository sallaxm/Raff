# Copy to .env.local and fill in. Never commit real keys.

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by API routes for uploads, downloads, moderation and payments.
# Do NOT prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site, used in auth email links and payment redirects/webhooks.
# Falls back to the request origin if unset. Must be public HTTPS in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Feedback page sends messages (opens the user's email app).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Payments: Tap Payments (Qatar, QAR). Leave empty to disable purchases. ---
# Dashboard: https://businesses.tap.company → API keys.
# sk_test_… for sandbox, sk_live_… in production. Server only.
TAP_SECRET_KEY=
# Optional. "src_all" = every method enabled on your account
# (NAPS/QPay debit, Visa, Mastercard, Apple Pay, Google Pay).
TAP_SOURCE_ID=src_all
