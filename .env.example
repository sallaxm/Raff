# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used for auth emails and payment redirects/webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments: Tap Payments (Qatar, QAR) -------------------------------------
# Dashboard: https://businesses.tap.company  → goTap → API keys
# Use sk_test_… for sandbox, sk_live_… in production. Server only.
TAP_SECRET_KEY=
# Optional. "src_all" = every method enabled on your account
# (NAPS/QPay debit, Visa, Mastercard, Apple Pay, Google Pay).
TAP_SOURCE_ID=src_all
